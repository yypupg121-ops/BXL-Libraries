# مكتبة ريكوستز الرسمية لـ BXL AI
# الطبقة البرمجية هنا عربية، والتنفيذ الحقيقي موجود داخل محرك BXL.

دالة get(الرابط):
    ارجع __native_requests.get(الرابط)

دالة get_with_headers(الرابط, الهيدرز):
    ارجع __native_requests.get(الرابط, الهيدرز)

دالة post(الرابط, البيانات):
    ارجع __native_requests.post(الرابط, البيانات)

دالة post_with_headers(الرابط, البيانات, الهيدرز):
    ارجع __native_requests.post(الرابط, البيانات, الهيدرز)

دالة put(الرابط, البيانات):
    ارجع __native_requests.put(الرابط, البيانات)

دالة delete(الرابط):
    ارجع __native_requests.delete(الرابط)

دالة تحميل_ملف(الرابط, المسار):
    ارجع __native_requests.تحميل_ملف(الرابط, المسار)
